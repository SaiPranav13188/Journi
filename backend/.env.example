# Copy to .env for local development. On Render, set these as Environment Variables.
PORT=4000

# Supabase → Project Settings → API. The service role key is SECRET: backend only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio → Get API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Backup models tried in order if the main one is overloaded.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# low = faster responses (Gemini 3 models)
GEMINI_THINKING_LEVEL=low

# Optional. Leave empty to use OpenStreetMap Nominatim + Wikipedia photos (free).
GOOGLE_PLACES_API_KEY=

# Shared secret for POST /jobs/refresh-weather (send as the x-cron-secret header).
CRON_SECRET=change-me-to-a-long-random-string
ENABLE_IN_PROCESS_CRON=true

# Agentic AI (v2). The daily weather job's decisions are made by the Weather
# Watcher agent; set to false to fall back to the fixed v1 rules.
AGENTIC_WEATHER_WATCHER=true
# Secret for the internal POST /v2/eval/run endpoint (x-eval-secret header).
# Defaults to CRON_SECRET when empty.
EVAL_SECRET=

# Nominatim/Wikipedia require an identifying User-Agent with contact info.
HTTP_USER_AGENT=JourniApp/1.0 (contact: you@example.com)
