{
  "name": "journi-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Journi API — itinerary generation, refinement and trip storage",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
