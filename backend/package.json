  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.82",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.118",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  }
}
